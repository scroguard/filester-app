# Maintainer: scroguard <github@justinalbrecht.com>
#
# Builds the tagged release from source. Suitable for the AUR as-is.
#
#   cd packaging/arch && makepkg -si
#
# CI (and local testing of unreleased commits) can point the source at a
# local checkout instead of the tag:
#
#   FILESTER_SOURCE="git+file://$PWD/../..#commit=$(git rev-parse HEAD)" makepkg
#
# The source is a git tag, so integrity comes from git's object hashes
# rather than a tarball checksum (hence SKIP).

pkgname=filester-app
pkgver=0.1.0
pkgrel=1
pkgdesc='Native GTK4/libadwaita client for the Filester cloud storage service (unofficial)'
arch=('x86_64' 'aarch64')
url='https://github.com/scroguard/filester-app'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'glib2' 'glibc' 'libgcc')
makedepends=('cargo' 'git' 'pkgconf')
optdepends=(
    'gnome-keyring: remember the API key (or any other Secret Service provider)'
    'kwallet: remember the API key on KDE'
    'keepassxc: remember the API key via its Secret Service integration'
)
# makepkg's LTO flags target C/C++ and can break the Rust link step.
options=('!lto')
source=("$pkgname::${FILESTER_SOURCE:-git+$url.git#tag=v$pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "$pkgname"
    local id=io.github.scroguard.Filester
    install -Dm755 target/release/filester-app "$pkgdir/usr/bin/filester-app"
    install -Dm644 "data/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    install -Dm644 "data/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
    install -Dm644 "data/icons/hicolor/scalable/apps/$id.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
